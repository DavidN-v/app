# Archivos que no se suben al repositorio

# Resultado de la compilación
/dist
/tmp
/out-tsc
/bazel-out

# Dependencias de Node
/node_modules
npm-debug.log
yarn-error.log

# Configuración de editores
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code: solo se comparte la configuración del proyecto
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# Cachés, cobertura de pruebas y otros temporales
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# Archivos del sistema operativo
.DS_Store
Thumbs.db
