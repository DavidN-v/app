# Configuración de las aplicaciones en el dispositivo físico. Copiar a devices/.env

# Dirección IP del ordenador donde corre la plataforma (broker MQTT y API)
SERVER=192.168.1.50

# 1 = conexión cifrada (puerto 8883, configuración de producción). Requiere copiar en devices/certs/
#     los archivos ca.crt, <dispositivo>.crt y <dispositivo>.key generados en el servidor.
# 0 = sin cifrar (puerto 1883, configuración de desarrollo, solo para una red de confianza)
MQTT_TLS=0

# --- Visión ------------------------------------------------------------------------
# Identificador con el que el dispositivo está dado de alta en la plataforma
VISION_DEVICE_ID=rpi5-vision
# Cámara: número de cámara USB (0), ruta (/dev/video0) o URL de vídeo (tcp://127.0.0.1:8888)
VISION_CAMERA=0
# Para una cámara USB, el dispositivo de Linux que se pasa al contenedor
VISION_CAMERA_DEVICE=/dev/video0
# Nombre y versión con los que el modelo figura en el registro de la plataforma
VISION_MODEL_NAME=yolo
VISION_MODEL_VERSION=8.1
VISION_FPS=2

# --- Modelo de lenguaje --------------------------------------------------------------
GENAI_DEVICE_ID=rpi5-genai
# Contraseña de la cuenta viewer de la plataforma (EG_VIEWER_PASSWORD en el servidor)
VIEWER_PASSWORD=viewer123

# --- Agente de anomalías ---------------------------------------------------------------
AGENT_DEVICE_ID=rpi5-agent
